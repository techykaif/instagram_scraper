(() => \{\
  window.followingCollector?.stop?.();\
\
  const dialog = document.querySelector('[role="dialog"]');\
\
  if (!dialog) \{\
    console.error("Open the Following dialog first.");\
    return;\
  \}\
\
  const collected = new Map();\
  let observer;\
  let stopped = false;\
\
  function usernameFromLink(a) \{\
    const match = (a.getAttribute("href") || "")\
      .match(/^\\/([A-Za-z0-9._]\{1,30\})\\/?$/);\
\
    return match ? match[1] : null;\
  \}\
\
  function findAccountRow(a) \{\
    let node = a;\
\
    // The diagnostic showed the account row around ancestor level 7.\
    for (let i = 0; i < 10 && node.parentElement; i++) \{\
      node = node.parentElement;\
\
      const links = [...node.querySelectorAll("a[href]")];\
      const usernames = links\
        .map(usernameFromLink)\
        .filter(Boolean);\
\
      // An account row generally contains two links to the same profile:\
      // one for the avatar and one for the username.\
      if (\
        usernames.length >= 2 &&\
        new Set(usernames.map(u => u.toLowerCase())).size === 1\
      ) \{\
        return node;\
      \}\
    \}\
\
    return a.parentElement;\
  \}\
\
  function getDisplayName(row, username) \{\
    if (!row) return "";\
\
    const usernameLower = username.toLowerCase();\
\
    // Find a non-avatar profile link whose visible text is the username.\
    const textLink = [...row.querySelectorAll("a[href]")]\
      .find(a =>\
        usernameFromLink(a)?.toLowerCase() === usernameLower &&\
        (a.innerText || "").trim().toLowerCase() === usernameLower\
      );\
\
    if (!textLink) return "";\
\
    // Look for nearby text elements within the same account row.\
    const candidates = [...row.querySelectorAll("span")]\
      .map(el => (el.innerText || "").trim())\
      .filter(text =>\
        text &&\
        text.toLowerCase() !== usernameLower &&\
        !/^(follow|following|message|remove)$/i.test(text) &&\
        !/verified/i.test(text) &&\
        !text.includes("\\n") &&\
        text.length <= 100\
      );\
\
    // The display name is usually near the username in the row.\
    // Prefer a candidate that is not just a repeated username.\
    return candidates[0] || "";\
  \}\
\
  function collectVisible() \{\
    if (stopped) return;\
\
    const links = [...dialog.querySelectorAll("a[href]")];\
\
    for (const a of links) \{\
      const username = usernameFromLink(a);\
      if (!username) continue;\
\
      const key = username.toLowerCase();\
      const previous = collected.get(key);\
\
      const row = findAccountRow(a);\
      const displayName = getDisplayName(row, username);\
\
      collected.set(key, \{\
        username,\
        displayName: displayName || previous?.displayName || "",\
        profileUrl: new URL(\
          a.getAttribute("href"),\
          location.origin\
        ).href,\
        collectedAt:\
          previous?.collectedAt || new Date().toISOString()\
      \});\
    \}\
\
    console.log(`Collected $\{collected.size\} unique profiles.`);\
  \}\
\
  function preview() \{\
    collectVisible();\
    console.table([...collected.values()]);\
  \}\
\
  function exportCSV() \{\
    collectVisible();\
\
    const rows = [\
      ["username", "displayName", "profileUrl", "collectedAt"],\
      ...[...collected.values()].map(r => [\
        r.username,\
        r.displayName,\
        r.profileUrl,\
        r.collectedAt\
      ])\
    ];\
\
    const csv = rows.map(row =>\
      row.map(value =>\
        `"$\{String(value).replace(/"/g, '""')\}"`\
      ).join(",")\
    ).join("\\r\\n");\
\
    const blob = new Blob(["\\uFEFF" + csv], \{\
      type: "text/csv;charset=utf-8;"\
    \});\
\
    const url = URL.createObjectURL(blob);\
    const link = document.createElement("a");\
\
    link.href = url;\
    link.download = "following_with_names.csv";\
    document.body.appendChild(link);\
    link.click();\
    link.remove();\
\
    setTimeout(() => URL.revokeObjectURL(url), 1500);\
\
    console.log(`Exported $\{collected.size\} profiles.`);\
  \}\
\
  function stop() \{\
    if (observer) observer.disconnect();\
    collectVisible();\
    stopped = true;\
    console.log("Stopped collecting.");\
  \}\
\
  function resume() \{\
    if (!stopped) return;\
\
    stopped = false;\
    observer = new MutationObserver(collectVisible);\
    observer.observe(dialog, \{\
      childList: true,\
      subtree: true,\
      characterData: true\
    \});\
\
    collectVisible();\
    console.log("Collector resumed.");\
  \}\
\
  observer = new MutationObserver(collectVisible);\
  observer.observe(dialog, \{\
    childList: true,\
    subtree: true,\
    characterData: true\
  \});\
\
  collectVisible();\
\
  window.followingCollector = \{\
    collect: collectVisible,\
    preview,\
    exportCSV,\
    stop,\
    resume,\
    get results() \{\
      return [...collected.values()];\
    \}\
  \};\
\
  console.log(`\
Collector running. Scroll normally.\
\
Commands:\
followingCollector.preview()\
followingCollector.stop()\
followingCollector.resume()\
followingCollector.exportCSV()\
followingCollector.results\
`);\
\})();\
\
\
